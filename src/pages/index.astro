---
/* ============================================================
   SPECTRE-9 // BLACK-OPS CYBER WARFARE
   Static Astro page. Client behaviour lives in classic IIFE
   scripts that only touch `window.*`, so they are bundled in
   their original load order from /src/scripts.
   ============================================================ */
import '../styles/variables.css';
import '../styles/layout.css';
import '../styles/panels.css';
import '../styles/effects.css';
import '../styles/responsive.css';
import '../styles/utilities.css';

const SITE_URL = (Astro.site?.toString() ?? 'https://hackerfeel.com').replace(/\/$/, '');
const PAGE_PATH = '/';

const TITLE = 'Hacker Feel — Fake Hacking Screen & Hacker Typer Simulator | SPECTRE-9';
const DESCRIPTION =
    'Free browser hacker typer, fake hacking screen, and hacker prank simulator. Mash any key for instant hacker typing, 60+ commands, and harmless movie pranks. 100% simulated.';

const ogImage = `${SITE_URL}/og.png`;

const webAppSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebApplication',
            '@id': `${SITE_URL}/#webapp`,
            name: 'SPECTRE-9 // Hacker Typer & Fake Hacking Screen Simulator',
            alternateName: [
                'HackerFeel',
                'hackerfeel.com',
                'SPECTRE-9 Hacker Terminal',
                'Hacker Typer Simulator',
                'Fake Hacking Screen',
                'Hacking Prank Simulator',
                'Hollywood Hacker Terminal',
                'Hacker Typer',
                'Fake Hacking',
                'Hacking Prank',
                'Hacker Typing',
                'Hacker Type',
                'HackerTyper',
                'Fake Hacker',
                'Hacker Prank',
                'Hacked Screen'
            ],
            url: `${SITE_URL}${PAGE_PATH}`,
            applicationCategory: 'EntertainmentApplication',
            applicationSubCategory: 'Simulation Game',
            operatingSystem: 'All modern web browsers (Chrome, Firefox, Safari, Edge, Android, iOS)',
            browserRequirements: 'Requires JavaScript and HTML5 Canvas',
            description: DESCRIPTION,
            image: ogImage,
            screenshot: ogImage,
            inLanguage: 'en',
            isAccessibleForFree: true,
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
            author: {
                '@type': 'Organization',
                name: 'HackerFeel / SPECTRE-9 Simulation Labs',
                url: SITE_URL
            },
            featureList: [
                'Instant Hacker Typer with real-time C, Python, and assembly code streaming',
                'Over 60 simulated interactive CLI terminal commands',
                '5 authentic CRT phosphor color schemes (Green, Cyan, Amber, Red, Purple)',
                'Edge-to-edge fullscreen Matrix digital rain animation',
                'Cinematic red security breach alarm and siren simulation',
                'Interactive real-time Cyber Defense Wargame simulator',
                'Procedural Web Audio sound synthesizer for mechanical keyboard clicks and synthwave music',
                'Drone and CCTV camera surveillance matrix simulator',
                'GPU hash cracker and cipher steganography lab',
                '100% simulated, client-side, safe for pranks and video production'
            ],
            keywords:
                'hacker typer, fake hacking, hacking prank, hacker typing, fake hacking screen, hacked screen, hackertyper, fake hacker, hacker prank, hacker type, hacker simulator, movie hacker screen, matrix rain, hollywood hacker'
        },
        {
            '@type': 'HowTo',
            '@id': `${SITE_URL}/#howto`,
            name: 'How to Use Hacker Typer to Create a Fake Hacking Screen Prank',
            description: 'Step-by-step guide to using the SPECTRE-9 hacker typer to simulate an authentic Hollywood hacker terminal for entertainment, streaming backgrounds, or harmless pranks.',
            step: [
                {
                    '@type': 'HowToStep',
                    name: 'Enter Fullscreen Mode',
                    text: 'Press F11 on your keyboard or click the Fullscreen icon [⛶] in the top navigation bar for edge-to-edge cinematic immersion.',
                    url: `${SITE_URL}/#fullscreen`
                },
                {
                    '@type': 'HowToStep',
                    name: 'Engage Hacker Typer Mode',
                    text: 'Select Option 1 [01 // HACKER TYPER] on the terminal titlebar or click Hacker Typer in the navigation menu.',
                    url: `${SITE_URL}/#hackertyper`
                },
                {
                    '@type': 'HowToStep',
                    name: 'Mash Any Keys to Stream Code',
                    text: 'Rapidly mash any keys on your keyboard. Authentic syntax-highlighted kernel, cryptography, and network routines stream onto the display in real time.',
                    url: `${SITE_URL}/#stream`
                },
                {
                    '@type': 'HowToStep',
                    name: 'Trigger Cinematic Commands',
                    text: 'Switch to Command Run mode [02 // COMMAND RUN] to execute simulated commands such as breach (security alert overlay), matrix (falling code rain), and scan (network port mapping).',
                    url: `${SITE_URL}/#commands`
                }
            ]
        }
    ]
};

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
        {
            '@type': 'Question',
            name: 'What is a hacker typer and how does it work?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'A hacker typer is an interactive web simulation that outputs realistic syntax-highlighted source code, assembly instructions, and cybersecurity logs whenever you press any key on your keyboard. In SPECTRE-9, simply mash any keys to stream authentic-looking code across a tactical black-ops terminal with zero setup.'
            }
        },
        {
            '@type': 'Question',
            name: 'How do you make your computer look like a fake hacking screen?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Open SPECTRE-9 in your web browser and press F11 (or click the fullscreen icon) for full-screen display. Select your preferred CRT phosphor theme (Green, Amber, Cyan, Red, or Purple), engage Hacker Typer mode to stream code as you type, or run simulated commands like scan, trace, breach, and matrix.'
            }
        },
        {
            '@type': 'Question',
            name: 'Can I use this fake hacking simulator for pranks and movie props?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes! SPECTRE-9 is 100% designed for harmless hacking pranks with friends and colleagues, cinematic video production, student films, and live stream backgrounds. It is completely safe, operates entirely client-side in your browser, and performs no real network attacks or data access.'
            }
        },
        {
            '@type': 'Question',
            name: 'Is hacker typing with SPECTRE-9 safe and legal?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes, it is 100% safe and legal. SPECTRE-9 is purely visual theatre rendered locally in your browser with HTML5 and WebGL. It contains no malware, sends no network exploits, and does not access your computer files, system settings, or personal data.'
            }
        },
        {
            '@type': 'Question',
            name: 'What commands can I run in the fake hacker terminal?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'SPECTRE-9 features over 60 simulated commands including scan (port mapping), trace (satellite routing), geoip (IP lookups), breach (penetration test animation), nuke (EMP shockwave), matrix (falling code rain), decrypt (GPU hash cracking), and theme (CRT phosphor color changer).'
            }
        },
        {
            '@type': 'Question',
            name: 'How do I trigger the Matrix falling code rain effect?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Switch to Command Run mode [02 // COMMAND RUN] in the terminal, type matrix, and press Enter. You can also customize the matrix speed and glyph density by typing matrix fast or matrix slow. Press Escape to exit Matrix mode.'
            }
        },
        {
            '@type': 'Question',
            name: 'Does SPECTRE-9 have hacker sound effects and typing audio?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes! SPECTRE-9 features a procedural Web Audio sound synthesizer that generates mechanical keyboard keystrokes, radar chirps, modem connection tones, and optional ambient synthwave background music without downloading external audio files.'
            }
        },
        {
            '@type': 'Question',
            name: 'Does SPECTRE-9 work on mobile devices and smartphones?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes, SPECTRE-9 is fully responsive on smartphones and tablets. It provides dedicated bottom touch navigation tabs (Terminal, Monitor, Network, and Logs) and works with both physical and virtual on-screen keyboards.'
            }
        }
    ]
};
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={DESCRIPTION} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#02060a" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={`${SITE_URL}${PAGE_PATH}`} />

    <title>{TITLE}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hacker Feel // SPECTRE-9 Terminal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={`${SITE_URL}${PAGE_PATH}`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SPECTRE-9 hacker terminal interface with green CRT phosphor text" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="SPECTRE-9 hacker terminal interface with green CRT phosphor text" />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/png" sizes="64x64" id="favicon-link" href="/favicons/favicon-green.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: preconnect to Google's font CDN; @font-face is inlined in CSS with font-display: swap -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- AEO / GEO / LLM Knowledge Discovery -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM Context Summary" />
    <meta name="ai-content-declaration" content="human-authored" />

    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</head>


<body class="mode-typer">

    <h1 class="sr-only">Hacker Typer &amp; Fake Hacker Terminal Simulator — SPECTRE-9 Black-Ops Command Center</h1>

    <!-- ============================ GLOBAL CRT / FX LAYER ============================ -->
    <div class="fx-layer" aria-hidden="true">
        <div class="fx-scanlines"></div>
        <div class="fx-noise"></div>
        <div class="fx-vignette"></div>
        <div class="fx-flicker"></div>
        <div class="fx-glitch" id="fx-glitch"></div>
    </div>

    <!-- ============================ MAIN APP ============================ -->
    <div id="app" class="app revealed" aria-hidden="false">

        <!-- ---------- TOP BAR ---------- -->
        <header class="topbar">
            <div class="topbar-brand" title="SPECTRE-9 // Black-Ops Cyber Warfare">
                <div class="brand-logo-wrap">
                    <img src="/logo.png" alt="SPECTRE-9 Skull Logo" class="brand-logo" width="28" height="28" loading="eager" />
                </div>
                <span class="brand-glyph">&gt;#</span>
                <span class="brand-name">SPECTRE-9</span>
                <span class="brand-sep">//</span>
                <span class="brand-sub">BLACK-OPS WARFARE</span>
            </div>
            <div class="topbar-meta">
                <div class="meta-item"><span class="meta-key">CONNECTION:</span> <span class="meta-val val-ok"
                        id="meta-connection">ENCRYPTED</span></div>
                <div class="meta-item"><span class="meta-key">NODE:</span> <span class="meta-val"
                        id="meta-node">UNKNOWN</span></div>
                <div class="meta-item"><span class="meta-key">SESSION:</span> <span class="meta-val"
                        id="meta-session">7F3A-92C1</span></div>
            </div>
            <div class="topbar-right">
                <span class="topbar-clock" id="topbar-clock">00:00:00</span>
                <button class="theme-picker-btn" id="btn-synth" title="Toggle Procedural Synthwave Ambient Music"><span class="theme-dot"></span> <span id="synth-label">SYNTH: OFF</span></button>
                <button class="theme-picker-btn" id="btn-theme" title="Cycle CRT Color Theme"><span class="theme-dot"></span> <span id="theme-name">GREEN</span></button>
                <button class="icon-btn" id="btn-brief" title="Mission Brief — Documentation" aria-label="Mission brief and FAQ">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.5"/><line x1="8" y1="7" x2="8" y2="11.5"/><circle cx="8" cy="4.5" r="0.8" fill="currentColor"/></svg>
                </button>
                <button class="icon-btn" id="btn-cam" title="Drone &amp; CCTV Surveillance Matrix" aria-label="Drone Cam">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="4.5" width="8.5" height="7" rx="1"/><polygon points="10,7.5 14.5,4.5 14.5,11.5 10,8.5" fill="none"/><circle cx="5.5" cy="8" r="1.5"/></svg>
                </button>
                <button class="icon-btn" id="btn-cipher" title="Cipher &amp; Steganography Lab" aria-label="Cipher Lab">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="10" height="7.5" rx="1"/><path d="M5.5 7V4.5a2.5 2.5 0 0 1 5 0V7"/><circle cx="8" cy="10.5" r="1" fill="currentColor"/></svg>
                </button>
                <button class="icon-btn" id="btn-exploit" title="Zero-Day Exploit Chain Builder" aria-label="Exploit Builder">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><line x1="8" y1="1" x2="8" y2="4"/><line x1="8" y1="12" x2="8" y2="15"/><line x1="1" y1="8" x2="4" y2="8"/><line x1="12" y1="8" x2="15" y2="8"/><circle cx="8" cy="8" r="1.5" fill="currentColor"/></svg>
                </button>
                <button class="icon-btn" id="btn-hashcrack" title="GPU Hash Cracker" aria-label="GPU Hash Cracker">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="8" height="8" rx="1"/><path d="M6 1.5v2.5M10 1.5v2.5M6 12v2.5M10 12v2.5M1.5 6h2.5M1.5 10h2.5M12 6h2.5M12 10h2.5"/><rect x="6.5" y="6.5" width="3" height="3" fill="currentColor"/></svg>
                </button>
                <button class="icon-btn" id="btn-darknet" title="Darknet Intelligence Feed" aria-label="Darknet Feed">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2.5" fill="currentColor"/><path d="M8 2v3.5M8 10.5V14M2 8h3.5M10.5 8H14M3.8 3.8l2.5 2.5M9.7 9.7l2.5 2.5M3.8 12.2l2.5-2.5M9.7 6.3l2.5-2.5"/></svg>
                </button>
                <button class="icon-btn" id="btn-cw" title="Launch Cyber Defense Wargame" aria-label="Cyber Defense Game">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><polygon points="9,1 3,9 8,9 7,15 13,7 8,7"/></svg>
                </button>
                <button class="icon-btn" id="btn-mute" title="Toggle sound" aria-label="Toggle sound">
                    <span class="icon-mute-off"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="2,5.5 5.5,5.5 9,2.5 9,13.5 5.5,10.5 2,10.5" fill="currentColor"/><path d="M11.5 5.5a4 4 0 0 1 0 5M13.5 3.5a6.5 6.5 0 0 1 0 9"/></svg></span>
                    <span class="icon-mute-on"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="2,5.5 5.5,5.5 9,2.5 9,13.5 5.5,10.5 2,10.5" fill="currentColor"/><line x1="11.5" y1="6" x2="14.5" y2="10"/><line x1="14.5" y1="6" x2="11.5" y2="10"/></svg></span>
                </button>
                <button class="icon-btn" id="btn-fullscreen" title="Toggle fullscreen" aria-label="Toggle fullscreen">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5.5V2.5h3M11 2.5h3v3M14 10.5v3h-3M5 13.5H2v-3"/></svg>
                </button>
            </div>
        </header>

        <!-- ---------- STATUS BAR ---------- -->
        <footer class="statusbar">
            <div class="status-leds">
                <span class="led led-green" id="led-online"><i></i>SYSTEM ONLINE</span>
                <span class="led led-green" id="led-encrypted"><i></i>ENCRYPTED</span>
                <span class="led led-cyan" id="led-proxy"><i></i>PROXY ACTIVE</span>
                <span class="led led-green" id="led-defcon"><i></i>DEFCON: <b>5</b></span>
                <span class="led led-amber" id="led-trace"><i></i>TRACE: <em id="trace-value">0%</em></span>
            </div>
            <div class="status-sim" id="status-sim">
                <span class="sim-dot">◆</span> ENCRYPTED MESH // NODE 0x9F ACTIVE
            </div>
        </footer>

        <!-- ---------- MAIN GRID ---------- -->
        <main class="main-grid">

            <!-- ===== LEFT SIDEBAR ===== -->
            <aside class="sidebar" id="sidebar">
                <nav class="side-nav" aria-label="Main navigation">
                    <div class="side-label">MAIN</div>
                    <button class="nav-item active" data-nav="terminal"><span class="nav-ic">▶</span> TERMINAL</button>
                    <button class="nav-item" data-nav="network"><span class="nav-ic">◈</span> NETWORK</button>
                    <button class="nav-item" data-nav="system"><span class="nav-ic">▦</span> SYSTEM</button>
                    <button class="nav-item" data-nav="exploits"><span class="nav-ic">⚡</span> EXPLOITS</button>
                    <button class="nav-item" data-nav="payloads"><span class="nav-ic">◉</span> PAYLOADS</button>
                    <button class="nav-item" data-nav="logs"><span class="nav-ic">▤</span> LOGS</button>
                    <button class="nav-item" data-nav="settings"><span class="nav-ic">⚙</span> SETTINGS</button>
                </nav>

                <div class="identity-panel">
                    <div class="identity-head">OPERATIVE PROFILE</div>
                    <div class="identity-rows">
                        <div class="id-row"><span>USER:</span><b>operator</b></div>
                        <div class="id-row"><span>UID :</span><b>0 [ROOT]</b></div>
                        <div class="id-row"><span>GID :</span><b>0 [BLACK-OPS]</b></div>
                        <div class="id-row"><span>GROUPS:</span><b>superuser,cyberwar</b></div>
                        <div class="id-row"><span>SECTOR:</span><b>09 [CLASSIFIED]</b></div>
                        <div class="id-row"><span>IP:</span><b id="id-ip">10.99.14.88</b></div>
                        <div class="id-row"><span>MASK:</span><b>255.255.255.0</b></div>
                        <div class="id-row"><span>GATEWAY:</span><b>10.99.14.1 [ONION]</b></div>
                    </div>
                    <div class="worldmap-wrap">
                        <canvas id="worldmap-canvas" class="worldmap-canvas"></canvas>
                        <div class="worldmap-label">3D VECTOR WIREGLOBE</div>
                    </div>
                </div>

                <div class="side-actions">
                    <button class="action-btn action-cw" id="btn-side-cw">⚡ CYBER DEFENSE WARGAME</button>
                    <button class="action-btn action-hacker" id="btn-hacker">[ HACKER TYPER ]</button>
                    <button class="action-btn action-matrix" id="btn-matrix">[ ENTER MATRIX MODE ]</button>
                    <button class="action-btn action-breach" id="btn-breach">RUN BREACH SIMULATION</button>
                </div>
            </aside>

            <!-- ===== CENTER TERMINAL ===== -->
            <section class="terminal-region panel" id="region-terminal">
                <h2 class="sr-only">Interactive hacker terminal console</h2>
                <div class="panel-titlebar">
                    <div class="term-tabs" role="tablist" aria-label="Terminal Operating Modes">
                        <button class="term-tab active" id="tab-mode-typer" role="tab" aria-selected="true" data-mode="typer" title="Option 1: Hacker Typer — Mash any keys to pour out code">
                            <span class="tab-status-dot"></span>
                            <span class="tab-title"><span class="tt-full">01 // HACKER TYPER</span><span class="tt-short">01 // TYPER</span></span>
                            <span class="tab-mode-tag">MASH KEYS</span>
                        </button>
                        <button class="term-tab" id="tab-mode-command" role="tab" aria-selected="false" data-mode="command" title="Option 2: Command Run — Interactive CLI terminal">
                            <span class="tab-status-dot"></span>
                            <span class="tab-title"><span class="tt-full">02 // COMMAND RUN</span><span class="tt-short">02 // CMD RUN</span></span>
                            <span class="tab-mode-tag">CLI EXEC</span>
                        </button>
                    </div>
                    <div class="panel-controls" aria-hidden="true">
                        <span class="pc pc-min">─</span><span class="pc pc-max">▢</span><span
                            class="pc pc-close">✕</span>
                    </div>
                </div>
                <div class="terminal-body" id="terminal-body">
                    <div class="terminal-output" id="terminal-output" role="log" aria-live="polite"
                        aria-label="Terminal output"><span class="t-line t-prompt-line">operator@spectre-9:~$ initializing black-ops tactical shell...</span></div>
                    <div class="terminal-inputline" id="terminal-inputline">
                        <span class="typer-hint" id="typer-hint">hacker typer armed — mash any key</span>
                        <span class="terminal-prompt" id="terminal-prompt"><span class="prompt-user">operator@spectre-9</span><span class="prompt-sep">:</span><span
                            class="prompt-path">~</span><span class="prompt-dollar">$</span></span>
                        <span class="terminal-input-wrap">
                            <span class="terminal-input-mirror" id="terminal-input-mirror"></span><span
                                class="terminal-caret" id="terminal-caret">█</span>
                        </span>
                        <input type="text" class="terminal-input" id="terminal-input" autocomplete="off"
                            autocorrect="off" autocapitalize="off" spellcheck="false"
                            aria-label="Terminal command input" />
                    </div>
                </div>
            </section>

            <!-- ===== RIGHT COLUMN ===== -->
            <aside class="right-column" id="right-column">

                <!-- SYSTEM MONITOR -->
                <section class="panel monitor-panel" data-panel="system">
                    <div class="panel-titlebar">
                        <h2 class="panel-title">SYSTEM MONITOR</h2>
                        <span class="panel-controls" aria-hidden="true"><span class="pc">─</span><span class="pc">▢</span><span
                                class="pc">✕</span></span>
                    </div>
                    <div class="panel-content monitor-content">
                        <div class="monitor-metrics">
                            <div class="metric">
                                <span class="metric-label">CPU</span>
                                <span class="metric-bar"><i id="bar-cpu"></i></span>
                                <span class="metric-val" id="val-cpu">72%</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">MEMORY</span>
                                <span class="metric-bar"><i id="bar-mem"></i></span>
                                <span class="metric-val" id="val-mem">54%</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">NETWORK</span>
                                <span class="metric-bar"><i id="bar-net"></i></span>
                                <span class="metric-val" id="val-net">81%</span>
                            </div>
                            <div class="metric-row"><span class="metric-label">UPTIME</span><span class="metric-plain"
